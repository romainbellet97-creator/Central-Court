# ─────────────────────────────────────────────────────────────────────────────
# Central Court — Backend Environment Variables
#
# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=central_court

# ── Security (required — app will refuse to start without this) ───────────────
# Generate a strong random value:  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-me-generate-a-strong-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In development this defaults to localhost Expo/web ports automatically.
# In production, set this to your actual domain(s):
# ALLOWED_ORIGINS=https://app.yourtennis.com,https://admin.yourtennis.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000,http://localhost:3000

# ── Anthropic API (Claude vision for OCR) ────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
# When set, Claude Haiku is used for receipt analysis (better accuracy than Tesseract).
# If unset, Tesseract OCR is used as fallback.
ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...your-key-here
SENDER_EMAIL=noreply@yourdomain.com

# ── AI Quick Replies (OpenAI / Emergent) ─────────────────────────────────────
EMERGENT_LLM_KEY=sk-...your-openai-key-here
